# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tech-mart-7vuc.onrender.com

# Database (omit for SQLite; set for PostgreSQL)
# DATABASE_URL=postgres://user:pass@host:5432/techmart
DATABASE_SSL_REQUIRE=false

# CORS / CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tech-mart-7vuc.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tech-mart-7vuc.onrender.com
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$|^https://.*\.onrender\.com$

# JWT cookies
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Strict

FRONTEND_BASE_URL=http://localhost:5173

# Super admin provisioning (create_techmart_admin)
PRIMARY_SUPER_ADMIN_USERNAME=techmart_admin
ADMIN_DEFAULT_USERNAME=techmart_admin
ADMIN_DEFAULT_EMAIL=admin@techmart.com
ADMIN_DEFAULT_PASSWORD=

# Email (console backend used when EMAIL_BACKEND unset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@techmart.com
EMAIL_BRAND_NAME=TechMart

# OAuth (must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SSLCommerz (sandbox defaults in settings when unset)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
